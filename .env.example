DATABASE_URL=postgres://postgres:postgres@localhost:5432/pr_tombstone?sslmode=disable
HTTP_ADDR=:8080
SERVER_PORT=8080
WEB_PORT=5173
GITHUB_APP_ID=0
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=TOKEN
PUBLIC_BASE_URL=http://localhost:5173
DASHBOARD_TOKEN=
# GitHub OAuth (dashboard login). Create an OAuth app under the GitHub App
# settings with callback URL <PUBLIC_BASE_URL>/api/auth/callback. When both
# values are set, dashboard access switches from the shared bearer token to
# per-user sessions scoped to the installations the user can access.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_TTL=336h
# Installation access is snapshotted at OAuth login and must be refreshed by
# signing in again after this interval. This bounds permission-revocation lag.
OAUTH_ACL_TTL=1h
AI_PROVIDER=rules
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
JOB_POLL_INTERVAL=2s
RETENTION_DAYS=30
# Vercel serverless deployment (see docs/VERCEL.md). DB pool defaults shrink
# automatically to 4 open / 1 idle when the VERCEL env var is present.
CRON_SECRET=
VERCEL_WORKER_BATCH=5
VERCEL_WORKER_BUDGET=50s
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
